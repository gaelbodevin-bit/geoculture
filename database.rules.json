{
  "rules": {
    "rooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null && ( (!data.exists() && newData.child('host').val() == auth.uid) || data.child('host').val() == auth.uid )",

        "code":                { ".validate": "newData.isString() && newData.val().length <= 12" },
        "host":                { ".validate": "!data.exists() && newData.isString() && newData.val() == auth.uid" },
        "createdAt":           { ".validate": "newData.isNumber()" },
        "round":               { ".validate": "newData.isNumber()" },
        "roundSeeds":          { ".validate": true },
        "countdownStart":      { ".validate": "newData.isNumber()" },
        "roundStart":          { ".validate": "newData.isNumber()" },
        "currentRoundResults": { ".validate": "newData.isNumber()" },
        "nextRound":           { ".validate": "newData.isNumber()" },
        "totalRounds":         { ".validate": "newData.isNumber()" },
        "options":             { ".validate": "newData.hasChildren()" },

        "status": {
          ".write": "auth != null && ( root.child('rooms').child($roomCode).child('host').val() == auth.uid || newData.val() == 'disbanded' )",
          ".validate": "newData.isString() && newData.val().matches(/^(waiting|countdown|playing|roundEnd|finished|disbanded)$/)"
        },
        "disbandedBy": { ".write": "auth != null", ".validate": "newData.isString()" },
        "disbandedAt": { ".write": "auth != null", ".validate": "newData.isNumber()" },

        "players": {
          "$pid": {
            ".write": "auth != null && ( $pid == auth.uid || root.child('rooms').child($roomCode).child('host').val() == auth.uid )",
            "name":     { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30 && !newData.val().matches(/[<>]/)" },
            "photo":    { ".validate": "newData.isString() && (newData.val() == '' || newData.val().matches(/^https:\\/\\/[\\w.~:\\/?#@!$&*+,;=%()-]+$/))" },
            "color":    { ".validate": "newData.isString() && newData.val().length <= 12" },
            "isHost":   { ".write": "!data.exists()", ".validate": "newData.isBoolean()" },
            "score":    { ".write": "auth != null && root.child('rooms').child($roomCode).child('host').val() == auth.uid", ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200000" },
            "online":   { ".validate": "newData.isBoolean()" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "eliminated": { ".validate": "newData.isBoolean()" },
            "$other":   { ".validate": false }
          }
        },

        "answers": {
          "$round": {
            "$pid": {
              ".write": "auth != null && ( $pid == auth.uid || root.child('rooms').child($roomCode).child('host').val() == auth.uid )",
              ".validate": "newData.hasChildren(['status', 'hintLevel']) && (newData.child('status').val() == 'active' || newData.hasChildren(['pts', 'dist', 'submittedAt']))",
              "status": { ".validate": "newData.isString() && newData.val().matches(/^(active|submitted|exhausted|eliminated)$/)" },
              "hintLevel": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
              "pts":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000" },
              "dist": { ".validate": "newData.val() == null || (newData.isNumber() && newData.val() >= 0)" },
              "submittedAt": { ".validate": "newData.isNumber()" },
              "hintStartAt": { ".validate": "newData.isNumber()" },
              "timeout":     { ".validate": "newData.isBoolean()" },
              "pos": {
                ".validate": "newData.val() == null || newData.hasChildren(['lat', 'lng'])",
                "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
                "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
                "$other": { ".validate": false }
              },
              "$other": { ".validate": false }
            }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
